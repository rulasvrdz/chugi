# Supabase (proyecto sellos-app-dev en local y previews)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca en NEXT_PUBLIC_* ni en logs.
SUPABASE_SECRET_KEY=

# Canal del código de registro: email | whatsapp
AUTH_OTP_CHANNEL=

# Solo servidor. Firma los QR de respaldo de la caja (HMAC-SHA256). Mínimo 32 caracteres.
# Genera uno con: openssl rand -base64 48
QR_SECRET=
